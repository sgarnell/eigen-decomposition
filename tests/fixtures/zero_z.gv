// Phase 02 fixture -- edge case: a zero z-score.
// Phase 01 accepts z >= 0, so `Zscore = 0.0` is valid and reaches Phase 02.
// With the default `zero-in-zero-out` policy the unified weight is exactly 0.0;
// the raw formula would instead give the attenuation limit (-s).  This fixture
// also guards against numpy RuntimeWarnings from log(0).
digraph G {
	graph [rankdir=LR size="10,10"]
	A -> "A--B" [label="Zscore = 0.5" arrowsize=0.4 color=blue penwidth=1.0 weight=3]
	"A--B" -> B [label="Zscore = 0.0" arrowsize=0.4 color=gray penwidth=0.1 weight=3]
	B -> "B--C" [label="Zscore = 0.0" arrowsize=0.4 color=gray penwidth=0.1 weight=3]
	"B--C" -> C [label="Zscore = 0.4" arrowsize=0.4 color=red penwidth=0.8 weight=3]
	A [label="A
cent= 0.1" color=brown2 shape=circle style=filled]
	B [label="B
cent= 0.2" color=brown2 shape=circle style=filled]
	C [label="C
cent= 0.1" color=brown2 shape=circle style=filled]
}
