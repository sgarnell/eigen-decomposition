// Phase 01 fixture -- a partial hub whose pre leg was removed upstream.
// Only the post edge ("M3--M4" -> M4) survives, so the hub is repairable with
// --allow-stub-edges and otherwise stays a hub_degree error.
digraph G {
	"M3--M4" -> M4 [label="Zscore = 0.7" color=gold penwidth=1.0]
	"M3--M4" [label="" color=cyan shape=circle style=filled]
	M3 [label="M3
cent= 0.1" color=brown2 shape=circle]
	M4 [label="M4
cent= 0.1" color=brown2 shape=circle]
}
